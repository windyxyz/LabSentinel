# T-333（L4）：Rust 单二进制镜像（Python 运行时已移除）。
# 多阶段：builder 编译 ls-server → runtime 只带二进制 + 内嵌 web + 模型挂载。
# 构建（Linux，需 rust:1.99 + cmake/libclang，ort feature 未启用时纯 Rust 即可）:
#   docker build -f deploy/docker/Dockerfile.rust -t labsentinel-server:0.2.0 .
# 运行: docker run -p 8000:8000 -v /data:/data -e LS_DB_PATH=/data/labsentinel.db labsentinel-server
FROM rust:1.99-bookworm AS builder
WORKDIR /build
COPY engine-rs/ ./engine-rs/
COPY proto/ ./proto/
COPY VERSION ./
WORKDIR /build/engine-rs
RUN cargo build --release -p ls-server

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 -d /data labsentinel
WORKDIR /app
COPY --from=builder /build/target/release/labsentinel-server /app/labsentinel-server
COPY web/dist/ /app/web/dist/
COPY VERSION /app/VERSION
RUN mkdir -p /data && chown -R labsentinel:labsentinel /data /app
USER labsentinel
ENV LS_DB_PATH=/data/labsentinel.db \
    LS_DATA_DIR=/data \
    LS_PORT=8000 \
    LS_WEB_DIST=/app/web/dist \
    LS_HOST=127.0.0.1
VOLUME ["/data"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s \
  CMD ["/app/labsentinel-server", "--healthcheck", "/data/labsentinel.db"]
CMD ["/app/labsentinel-server"]
