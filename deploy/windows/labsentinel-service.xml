<!-- T-611 / RA4.2：Windows 服务模式（WinSW 包装，LocalService 账户）。
     安装（管理员，把本文件与 WinSW.exe 放到解压后的安装根）：
       winsw.exe install deploy\windows\labsentinel-service.xml
       winsw.exe start
     限制：Session 0 无法访问 USB 摄像头——服务模式仅建议 RTSP/文件夹源。
     数据目录改 %ProgramData%\LabSentinel（服务账户可写，与用户模式数据隔离）。 -->
<service>
  <id>labsentinel</id>
  <name>LabSentinel 实验室安全监控</name>
  <description>本地实验室安全行为监控（Rust 单二进制，无外部运行时依赖）</description>
  <executable>%BASE%\labsentinel-server.exe</executable>
  <workingdirectory>%BASE%</workingdirectory>
  <logpath>%ProgramData%\LabSentinel\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>
  <env name="LS_DATA_DIR" value="%ProgramData%\LabSentinel\data"/>
  <env name="LS_DB_PATH" value="%ProgramData%\LabSentinel\data\labsentinel.db"/>
  <env name="LS_WEB_DIST" value="%BASE%\web"/>
  <env name="LS_MODEL_PATH" value="%BASE%\models\yolo11n.onnx"/>
  <env name="LS_HOST" value="127.0.0.1"/>
  <env name="LS_PORT" value="8000"/>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
</service>
