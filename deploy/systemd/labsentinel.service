[Unit]
Description=LabSentinel 实验室安全监控（Rust 单二进制）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=labsentinel
Group=labsentinel
WorkingDirectory=/opt/labsentinel
Environment=LS_DATA_DIR=/var/lib/labsentinel/data
Environment=LS_DB_PATH=/var/lib/labsentinel/data/labsentinel.db
Environment=LS_WEB_DIST=/opt/labsentinel/web
Environment=LS_MODEL_PATH=/opt/labsentinel/models/yolo11n.onnx
Environment=LS_HOST=127.0.0.1
Environment=LS_PORT=8000
EnvironmentFile=-/etc/labsentinel/config.env
ExecStart=/opt/labsentinel/labsentinel-server
Restart=on-failure
RestartSec=5
StateDirectory=labsentinel
# 安全加固（T-601）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/labsentinel

[Install]
WantedBy=multi-user.target
