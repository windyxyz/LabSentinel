# LabSentinel 配置模板
# 复制为 server/.env 生效。所有项均可省略（省略即用默认值，留空=不启用）。
# 完整部署说明见 docs/部署指南.md

# ---- 模型路径 ----
# 相对路径以 server/ 为基准；Docker 部署改用容器内路径
# LS_MODEL_FP32=../m0-spike/yolo11n.onnx
# LS_MODEL_INT8=../m0-spike/yolo11n_xint8_hd.onnx

# ---- 推理 ----
# LS_BACKEND_ORDER=directml,vitisai,cpu
# LS_IMGSZ=640
# LS_CONF_THRES=0.40
# LS_IOU_THRES=0.50
# LS_ANALYSIS_FPS=5.0          # 每路分析帧率上限
# LS_MIN_BOX_AREA=1200         # 过滤远处小框误检（720p 像素面积）
# LS_FILE_LOOP=false           # 文件源循环播放（压测/演示用）

# ---- 实验服（PPE）检测 ----
# LS_PPE_MODEL=../m0-spike/yolo11n_ppe.onnx
# LS_PPE_CLASS_NAMES=lab coat        # 穿戴证据类别（逗号分隔多个）
# LS_PPE_VIOLATION_CLASS=no lab coat # 显式违规类别（只有它才触发告警）
# LS_PPE_CONF=0.30                   # 违规判定阈值
# LS_PPE_WEARING_CONF=0.20           # 穿戴证据阈值

# ---- 实时画面（go2rtc 网关）----
# LS_GO2RTC_API=127.0.0.1:1984
# LS_GO2RTC_YAML=../tools/go2rtc.yaml

# ---- 管理鉴权（任务16；为空 = 不启用，内网信任场景）----
# 启用后：所有写操作（POST/DELETE）需带 X-Admin-Token 头；WS 用 ?token=；/api/system 永不拦截
# LS_ADMIN_TOKEN=your-secret-token
# LS_AUTH_READ_PROTECTED=false     # true 时读操作也要求令牌

# ---- 数据保留（任务14，合规：最小化存储）----
# LS_RETENTION_EVENTS_DAYS=180      # 事件记录保留天数（过期整行删除，含截图/视频文件）
# LS_RETENTION_POOL_DAYS=90         # 误报标注池文件保留天数
# LS_DISK_MIN_FREE_GB=5             # 磁盘低于此值触发紧急清理（从最旧事件删起）
# LS_PDF_FONT=C:\Windows\Fonts\msyh.ttc   # PDF 月报中文字体（默认微软雅黑）

# ---- 告警渠道（多选，未配置的自动跳过）----
# 企业微信群机器人（仅 qyapi.weixin.qq.com）
# LS_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 钉钉机器人（仅 oapi.dingtalk.com）
# LS_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# 飞书群机器人（仅 open.feishu.cn）
# LS_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# Server酱 → 微信服务号（sctapi.ftqq.com，SendKey 见 sct.ftqq.com）
# LS_SERVERCHAN_SENDKEY=SCTxxxx
# PushPlus → 微信公众号（www.pushplus.plus）
# LS_PUSHPLUS_TOKEN=xxx
# Qmsg酱 → QQ 私聊（qmsg.zendee.cn，key 与目标 QQ 号都要配）
# LS_QMSG_KEY=xxx
# LS_QMSG_QQ=10000
# SMTP 邮件（QQ 邮箱填 smtp.qq.com，密码用授权码；端口 465=SSL）
# LS_SMTP_HOST=smtp.qq.com
# LS_SMTP_PORT=465
# LS_SMTP_USER=user@qq.com
# LS_SMTP_PASS=auth-code
# LS_ALERT_EMAIL_TO=security@example.com

# ---- 人脸比对（合规敏感，默认必须关闭；开启前必读 docs/部署指南.md 合规章节）----
# LS_FACE_ENABLED=false
# LS_COMPREFACE_URL=http://127.0.0.1:18000/api/v1
# LS_COMPREFACE_API_KEY=xxx
# LS_FACE_THRESHOLD=0.75
# LS_FACE_COOL_S=30

# ---- 单端口模式（任务43）：npm run build 后由服务端托管 web/dist，只开 8000 ----
# 默认 ../web/dist（相对 server/）；打包版可指向便携目录。缺 index.html 时 GET / 返回提示 JSON。
# LS_WEB_DIST=D:/path/to/dist
