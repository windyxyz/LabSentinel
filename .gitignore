# ---- 环境与密钥（零入库）----
server/.env
.env
*.env.local

# ---- 运行数据（事件库/截图/视频/标注池）----
server/data/

# ---- 模型与权重（不随库分发，见 NOTICE）----
m0-spike/*.onnx
m0-spike/*.pt
m0-spike/*.classes.txt
m0-spike/calib/
m0-spike/out_s*/
m0-spike/data/
m0-spike/quantized_info.csv

# ---- Resources：非项目文件归集（资源/示例/数据集/生成物，见 Resources/README.md）----
Resources/datasets/
Resources/runs/
Resources/logs/
Resources/dist/
.training.lock

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# ---- Node / Web ----
web/node_modules/
web/dist/

# ---- 临时与工具产物 ----
.mimosa/
.zcode/
*.log
Thumbs.db

# ---- 部署生成物（新机由 deploy.py 重建；Resources/dist 里是分发包）----
scripts/venv_path.txt
tools/node/
# go2rtc.yaml 由服务端/deploy.py 按本机路径生成
tools/go2rtc.yaml

# ---- 二进制组件（可再下载，见 NOTICE 与部署指南；不入库）----
tools/ffmpeg/
tools/go2rtc.exe

# ---- 误建环境残留（防御）----
server/LabSentinelgpu-venv/

# ---- Mixkit 派生演示素材（仅个人使用，不入库；70-release-plan）----
Resources/效果演示/*.mp4
Resources/效果演示/*.jpg

# ---- Rust 工作区（engine-rs）----
engine-rs/target/
**/*.rs.bk
